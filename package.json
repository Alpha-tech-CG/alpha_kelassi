{
  "name": "alpha-kelassi",
  "private": true,
  "version": "0.1.0",
  "description": "App mobile/web de préparation aux examens d'État — Congo Brazzaville",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate-types": "supabase gen types typescript --local > packages/types/src/database.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "postcss": "^8.5.18"
    }
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "eslint-scope": "^8.4.0",
    "eslint-visitor-keys": "^4.2.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastefox2742/alpha-kelassi.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mastefox2742/alpha-kelassi/issues"
  },
  "homepage": "https://github.com/mastefox2742/alpha-kelassi#readme"
}
