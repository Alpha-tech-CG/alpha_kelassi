{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kelassi-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@alpha-kelassi/web", "dev"],
      "port": 3000
    },
    {
      "name": "kelassi-web-turbo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@alpha-kelassi/web", "exec", "next", "dev", "--turbopack", "--port", "3000"],
      "port": 3000
    },
    {
      "name": "kelassi-mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@alpha-kelassi/mobile", "exec", "expo", "start", "--web", "--port", "8081"],
      "port": 8081
    }
  ]
}
