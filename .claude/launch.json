{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kelassi-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@alpha-kelassi/web", "dev"],
      "port": 3000
    },
    {
      "name": "kelassi-web-turbo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@alpha-kelassi/web", "exec", "next", "dev", "--turbopack", "--port", "3000"],
      "port": 3000
    },
    {
      "name": "kelassi-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@alpha-kelassi/api", "dev"],
      "port": 3001
    }
  ]
}
