# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Auth
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# Gemini AI
GEMINI_API_KEY=AIza...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# FeexPay (Mobile Money) — payout retrait tuteur (côté web)
FEEXPAY_TOKEN=xxxx
FEEXPAY_SHOP=xxxx

# BullMQ (same Redis as Upstash)
QUEUE_REDIS_URL=rediss://xxxx:password@xxxx.upstash.io:6379

# Sentry (monitoring d'erreurs prod) — crée un projet sur sentry.io puis colle
# le DSN ici. Sans valeur, Sentry.init() est no-op (voir sentry.*.config.ts).
# À renseigner en vraie valeur dans les env vars Vercel (Production/Preview).
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
