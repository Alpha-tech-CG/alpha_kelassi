# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement — apps/web (Next.js, API de production).
# Liste alignée sur ce que le code lit réellement (process.env[...]).
# En prod : renseigner ces valeurs dans les env vars Vercel (Production/Preview).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (requis)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL publique du site (requis)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis — quotas / rate-limit (requis en prod)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# Gemini AI (requis pour tuteur / flashcards / corrections)
GEMINI_API_KEY=AIza...

# FeexPay — Mobile Money (abonnements + retraits tuteurs). REMPLACE Stripe/CinetPay.
#   FEEXPAY_CALLBACK_URL = URL du webhook à déclarer chez FeexPay :
#   https://<site>/api/billing/feexpay/webhook
FEEXPAY_TOKEN=xxxx
FEEXPAY_SHOP=xxxx
FEEXPAY_CALLBACK_URL=https://xxxx/api/billing/feexpay/webhook

# Cron Vercel (requis pour /api/cron/subscriptions et /api/cron/reminders).
# Vercel ajoute automatiquement `Authorization: Bearer $CRON_SECRET` aux appels
# cron quand cette variable est définie ; sans elle, les crons répondent 401 (no-op).
CRON_SECRET=xxxx

# WhatsApp Business Cloud API (Meta) — rappels sortants + webhook entrant.
# Sans configuration, l'envoi et le webhook sont des no-op propres.
#   - WHATSAPP_VERIFY_TOKEN : jeton du handshake GET du webhook.
#   - WHATSAPP_APP_SECRET   : secret d'app Meta, vérifie la signature POST.
#   - template Meta approuvé `revision_reminder` (fr, 1 paramètre) requis côté Meta.
WHATSAPP_PHONE_NUMBER_ID=xxxx
WHATSAPP_ACCESS_TOKEN=xxxx
WHATSAPP_VERIFY_TOKEN=xxxx
WHATSAPP_APP_SECRET=xxxx
# Optionnel (défaut v21.0)
WHATSAPP_API_VERSION=v21.0

# SMS Africa's Talking — repli quand WhatsApp échoue (optionnel).
AT_API_KEY=xxxx
AT_USERNAME=sandbox
AT_SENDER_ID=Kelassi

# Accès admin : liste d'e-mails séparés par des virgules (optionnel, surcharge
# l'allowlist par défaut du code).
ADMIN_EMAILS=admin@example.com

# Page de téléchargement de l'APK Android (optionnel — affichage /telecharger).
NEXT_PUBLIC_ANDROID_APK_URL=https://xxxx/cognix.apk
NEXT_PUBLIC_ANDROID_APK_VERSION=1.0.1
NEXT_PUBLIC_ANDROID_APK_SIZE=30 Mo

# Sentry (monitoring d'erreurs prod, optionnel) — sans DSN, Sentry.init() est no-op.
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
