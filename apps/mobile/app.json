{
  "expo": {
    "name": "Cognix",
    "slug": "kelassi",
    "version": "1.0.13",
    "runtimeVersion": "1.0.6",
    "scheme": "kelassi",
    "orientation": "portrait",
    "jsEngine": "hermes",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#00030C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kelassi.app",
      "buildNumber": "14",
      "infoPlist": {
        "NSCameraUsageDescription": "Utilisé pour scanner des documents de cours",
        "NSFaceIDUsageDescription": "Utilisé pour déverrouiller l'application après une période d'inactivité",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00030C"
      },
      "package": "com.kelassi.app",
      "versionCode": 14,
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-file-system",
        {}
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Utilisé pour joindre la photo de ton énoncé et de ton travail à corriger."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ad3730f4-1cad-4acb-b4b9-f1f7bf722fcc"
      }
    },
    "owner": "m.mboniobambi"
  }
}
